{
  "expo": {
    "name": "Jotna School",
    "slug": "jotna-school",
    "scheme": "jotna",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.jotna.school",
      "edgeToEdgeEnabled": true
    },
    "ios": {
      "bundleIdentifier": "com.jotna.school",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
