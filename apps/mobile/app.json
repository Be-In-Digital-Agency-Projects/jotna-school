{
  "expo": {
    "name": "Jotna School",
    "slug": "jotna-school",
    "scheme": "jotna",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "android": {
      "package": "com.jotna.school",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f97316"
      }
    },
    "ios": {
      "bundleIdentifier": "com.jotna.school",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "../../public/jotna-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#fffbeb"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
