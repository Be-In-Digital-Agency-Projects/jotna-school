# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/.context

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Espace de travail scratch subagent-driven-development
.superpowers/
.ci-local/

# --- Monorepo mobile (plan docs/superpowers/plans/2026-09-25-application-mobile-eleve.md) ---
# `/node_modules` plus haut est ANCRÉ À LA RACINE : il ne couvre pas
# `apps/mobile/node_modules`, que pnpm crée dans un workspace.
node_modules/

# Expo
.expo/
apps/mobile/dist/
# Sorties de `expo prebuild` : régénérables, jamais versionnées tant qu'on
# n'a pas de modification native à la main.
apps/mobile/android/
apps/mobile/ios/

# Signature d'applications — ne DOIT jamais entrer au dépôt.
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
